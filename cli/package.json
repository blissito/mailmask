{
  "name": "mailmask-cli",
  "version": "0.1.0",
  "description": "CLI oficial de MailMask — gestiona dominios, direcciones, DNS, reglas, webhooks y más desde la terminal.",
  "type": "module",
  "bin": {
    "mailmask": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "tsx --experimental-test-module-mocks --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@easybits.cloud/mailmask": "^0.4.10",
    "citty": "^0.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.0.0",
    "tsx": "^4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mailmask",
    "email",
    "cli",
    "dns"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blissito/mailmask.git",
    "directory": "cli"
  },
  "homepage": "https://www.mailmask.studio/docs.html#cli"
}
