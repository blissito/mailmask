# BUCKET
S3_BUCKET=mailmaks

# SNS: entrada (SES inbound → /api/webhooks/ses-inbound) y salida (rebotes y quejas → /api/webhooks/ses-events)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:mailmask-notifications
SNS_OUTBOUND_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:mailmask-outbound-events

SIDECAR_URL=https://monitor-kuma.fly.dev
SIDECAR_SECRET=sdfgdsfgdfsg

# MercadoPago
MP_ACCESS_TOKEN=your_access_token
MP_WEBHOOK_SECRET=your_webhook_secret

# Cloudflare Turnstile (captcha del registro).
# La clave del sitio es pública y vive en public/register.html; sólo la secreta
# va aquí. Sin TURNSTILE_SECRET no se verifica nada: así corren dev y las pruebas.
TURNSTILE_SECRET=

# Buzón IMAP (Stalwart). Vacío = desactivado; nadie recibe copia en el buzón.
# El depósito va por JMAP sobre HTTPS y no por LMTP porque la plataforma donde
# vive el buzón sólo expone capa 7. Ver CLAUDE.md.
IMAP_JMAP_URL=
IMAP_JMAP_USER=
IMAP_JMAP_PASSWORD=
IMAP_ENABLED_DOMAINS=
# Administrador de Stalwart: entrega en cualquier buzón y provisiona cuentas (stalwart.ts).
STALWART_ADMIN_URL=https://imap.mailmask.studio
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=
# Tigris: blob store de Stalwart (cuerpos de buzón, cero egreso). Sólo para scripts locales;
# la app no lo usa. NO correr `fly storage create` dentro del repo: pisa los AWS_* de la app.
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_BUCKET=mailmask-buzones
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
