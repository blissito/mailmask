{
  "name": "mailmask",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch main.ts",
    "start": "tsx main.ts",
    "test": "NODE_OPTIONS=\"--import ./test-setup.mjs\" DATABASE_PATH=./data/test.db JWT_SECRET=test-secret-key MP_ACCESS_TOKEN=test MP_WEBHOOK_SECRET=test AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_ENDPOINT_URL=http://localhost:1 tsx --test --test-timeout=60000 --test-concurrency=1 --experimental-test-module-mocks",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build:css": "npx tailwindcss -c tailwind.config.ts -i public/css/input.css -o public/css/styles.css --minify",
    "build:chat": "esbuild public/js/docs-chat.tsx --bundle --outfile=public/js/docs-chat.js --format=esm --jsx=automatic --target=es2020 --minify",
    "check:skills": "npx tsx scripts/skills-pack.mts",
    "skills:pack": "npx tsx scripts/skills-pack.mts --write",
    "skills:publish": "npm run check:skills && git subtree push --prefix public/skills git@github.com:blissito/mailmask-skills.git main",
    "build:composer": "NODE_ENV=production esbuild public/js/composer.ts --bundle --outfile=public/js/composer.js --format=iife --target=es2020 --minify"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3",
    "@aws-sdk/client-route-53": "^3.1142.0",
    "@aws-sdk/client-route-53-domains": "^3.1142.0",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/client-ses": "^3",
    "@aws-sdk/client-sesv2": "^3",
    "@aws-sdk/client-sns": "^3",
    "@elysiajs/node": "^1.2",
    "@elysiajs/openapi": "^1.4.16",
    "@formmy.app/chat": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@streamdown/code": "^1.1.1",
    "better-sqlite3": "^11",
    "drizzle-orm": "^0.45",
    "elysia": "^1.4",
    "html-to-text": "^10.0.1",
    "juice": "^12.2.0",
    "markdown-it": "^15.0.2",
    "markdown-it-github-alerts": "^1.0.1",
    "mercadopago": "^2",
    "node-cron": "^3",
    "postal-mime": "^2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "streamdown": "^2.6.0",
    "tsx": "^4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/better-sqlite3": "^7",
    "@types/html-to-text": "^9.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22",
    "@types/node-cron": "^3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "deepmerge-ts": "^8.0.1"
  }
}
