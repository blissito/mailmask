{
  "name": "@easybits.cloud/mailmask",
  "version": "0.4.12",
  "description": "Official SDK for the MailMask email alias/forwarding API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly && node scripts/postbuild-dts.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:consumer": "node scripts/check-consumer-legacy.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mailmask",
    "email",
    "alias",
    "forwarding",
    "sdk"
  ],
  "license": "MIT"
}
